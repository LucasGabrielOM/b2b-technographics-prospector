POSTGRES_DB=prospector
POSTGRES_USER=prospector
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://prospector:change-me@postgres:5432/prospector
API_BASE_URL=http://api:8000
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
N8N_USER=admin
N8N_PASSWORD=change-me-now

# IA (sem chave, o sistema usa um gerador demo determinístico)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Enriquecimento opcional
HUNTER_API_KEY=
SERPER_API_KEY=

# Envio permanece bloqueado até as duas opções abaixo serem configuradas.
OUTREACH_ENABLED=false
OUTREACH_WEBHOOK_URL=

# Identificação responsável do crawler
CRAWLER_USER_AGENT=B2BProspector/1.0 (https://github.com/LucasGabrielOM/b2b-technographics-prospector)
REQUEST_TIMEOUT_SECONDS=12
DISCOVERY_CONCURRENCY=8
